{
  "name": "redux-injectable-middleware",
  "version": "1.1.0",
  "description": "Middleware that allows asynchronous injection of other middlewares",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/index.js": "./dist/index.js",
    "./dist/index.mjs": "./dist/index.mjs",
    "./src/index.js": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types"
  ],
  "sideEffects": false,
  "repository": "https://github.com/Mulletware/redux-injectable-middleware",
  "author": "Dustin Schultz <dustindschultz@gmail.com>",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "pretest": "npm run build",
    "test": "node --test",
    "test:types": "tsc -p tsconfig.types.json",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "redux": "^4.2.0 || ^5.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "rollup": "^4.9.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.3.0"
  }
}
